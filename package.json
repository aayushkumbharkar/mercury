{
  "name": "mercury-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "auth": "node --env-file-if-exists=.env --experimental-strip-types src/auth.ts",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types src/seed.ts",
    "evaluate": "node --experimental-strip-types scripts/evaluate.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm test && npm run build && npm run evaluate"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
